# ── Database ──────────────────────────────────────────────────────────────────
# Options: "sqlite" or "postgresql"
DB_TYPE=sqlite
SQLITE_PATH=/data/caero.db

# PostgreSQL (only used when DB_TYPE=postgresql)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=caero
PG_USER=caero
PG_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to true to bypass login and auto-use the first user
SINGLE_USER_MODE=false

# Change this to a long random string in production!
# If left at the default (outside single-user mode), Caero generates a random
# key on every start — the app stays secure, but logins won't survive restarts.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Token expiry in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── SMTP / Email notifications ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=caero@localhost
SMTP_TLS=true

# ── Telegram bot notifications ────────────────────────────────────────────────
# Create a bot with @BotFather and set the token below.
TELEGRAM_BOT_TOKEN=

# ── Webhook notifications ─────────────────────────────────────────────────────
# Each configured channel receives every notification (price alerts, broken
# selectors, redirects, …) in addition to per-alert email/Telegram recipients.
# NOTE: these are global broadcast channels — in multi-user setups, alerts
# from ALL users land here. Meant for household/single-admin deployments.
# ntfy: the full topic URL, e.g. https://ntfy.sh/my-caero-topic
NTFY_URL=
# Gotify: server base URL + application token
GOTIFY_URL=
GOTIFY_TOKEN=
# Discord: channel webhook URL
DISCORD_WEBHOOK_URL=

# ── Timezone ──────────────────────────────────────────────────────────────────
# Product check times (HH:mm) are interpreted in the container's local timezone.
# Docker defaults to UTC — set your zone so "10:00" means your 10:00.
TZ=Europe/Berlin

# ── Scraper ───────────────────────────────────────────────────────────────────
# "false" (default) runs a headed browser — in Docker it is hidden inside xvfb
# and is harder for shops to detect. "true" runs truly headless.
SCRAPER_HEADLESS=false

# Browser locale and timezone used while scraping. Keep them consistent with
# each other (a de-DE browser in America/New_York is a bot-detection red flag).
SCRAPER_LOCALE=de-DE
SCRAPER_TIMEZONE=Europe/Berlin

# Max parallel scrapes and how many consecutive failures trigger the
# "selector broken" notification.
#
# Memory: one Chromium is launched at startup and shared; each parallel scrape
# adds a browser context and its own renderer process on top. With
# SCRAPER_HEADLESS=false the whole tree runs under xvfb and the base browser
# alone measured ~620 MB RSS, with each extra concurrent scrape adding roughly
# 50-200 MB depending on the page. Budget for it before raising this: caero has
# no memory ceiling of its own, so on a small host the scrape burst is what
# runs the box out of RAM. Set mem_limit in docker-compose.yml so caero dies
# alone instead of stalling every other service on the machine.
SCRAPER_CONCURRENCY=2
SCRAPER_FAILURE_ALERT_THRESHOLD=3

# Random offset per product so shared check times don't fire in one burst.
# The window is max(SCHEDULE_JITTER_SECONDS, cohort x
# SCHEDULE_JITTER_PER_PRODUCT_SECONDS), where the cohort is how many products
# share that check time — a fixed window stops spreading anything once the
# cohort is large enough that jobs start faster than a scrape finishes.
# It is capped at the product's own check interval.
# SCHEDULE_JITTER_SECONDS=0 disables jitter entirely.
SCHEDULE_JITTER_SECONDS=300
SCHEDULE_JITTER_PER_PRODUCT_SECONDS=120

# Hard ceiling on one scrape, covering the whole browser interaction and not
# just page load. A wedged browser otherwise holds its concurrency slot forever
# and enough of them stop scraping entirely. 0 disables.
SCRAPE_TIMEOUT_SECONDS=120

# Infrastructure failures (dead browser, no network, host out of memory) make
# every product fail at once. Past this many distinct products failing with no
# success in between, the per-product "selector broken" mail is replaced by one
# "scraping is down" message per affected user. 0 disables.
SCRAPE_STORM_MIN_PRODUCTS=3

# How late a missed scrape may still run, in seconds. Under load a scrape can
# overrun its next slot; without a grace time the run is dropped outright and
# price history silently gains a gap. 0 = always run, no matter how late.
SCRAPE_MISFIRE_GRACE_SECONDS=3600

# When running behind a reverse proxy, set this to the proxy's IP (or "*" if
# the app port is not reachable directly) so login rate limiting sees real
# client IPs from X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Maintenance ───────────────────────────────────────────────────────────────
# Daily JSON backup (03:30) into <data dir>/backups, keeping the newest N
# files. 0 disables backups.
BACKUP_KEEP=7

# Thin price history older than N days down to the daily min/max per product
# (useful with "record every check"). 0 (default) keeps everything forever.
PRICE_HISTORY_THIN_AFTER_DAYS=0

# Application log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
