# ── Database ──────────────────────────────────────────────────────────────────
# Options: "sqlite" or "postgresql"
DB_TYPE=sqlite
SQLITE_PATH=/data/caero.db

# PostgreSQL (only used when DB_TYPE=postgresql)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=caero
PG_USER=caero
PG_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to false to require JWT authentication
SINGLE_USER_MODE=true

# Change this to a long random string in production!
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Token expiry in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── SMTP / Email notifications ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=caero@localhost
SMTP_TLS=true
